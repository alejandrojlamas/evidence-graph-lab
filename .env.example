# Obligatorio antes de habilitar una fuente de red. Usa una URL que supervises.
RED_PRIVADA_USER_AGENT="RedPrivada/0.1 (+https://github.com/alejandrojlamas/red-privada)"

# Compatibilidad 0.x: EVIDENCE_GRAPH_USER_AGENT también se acepta si la variable anterior falta.

# Opcional: solo se usa con llm.provider=deepseek o cuando auto selecciona DeepSeek.
DEEPSEEK_API_KEY=

# Motor Neo4j opcional. Genera una contraseña única y nunca añadas el .env poblado al repositorio.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
