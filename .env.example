# Required before enabling any network source. Use a URL you actively monitor.
RED_PRIVADA_USER_AGENT="RedPrivadaBot/0.1 (+https://github.com/alejandrojlamas/Red-privada)"

# Optional: only used when llm.provider is deepseek or auto selects DeepSeek.
DEEPSEEK_API_KEY=

# Optional Neo4j backend. Generate a unique password; never commit the populated .env.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
